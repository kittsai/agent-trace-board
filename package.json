{
  "name": "agent-insight-board",
  "version": "0.1.0",
  "private": true,
  "description": "从 AI Agent 执行过程中萃取可复用知识的工具",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python3 -m uvicorn main:app --host 0.0.0.0 --port 18080 --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd backend && python3 -m uvicorn main:app --host 0.0.0.0 --port 18080",
    "list": "cd backend && python3 cli.py list"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
